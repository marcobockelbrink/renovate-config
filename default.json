{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for all of Marco's repositories",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":rebaseStalePrs"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  "platformAutomerge": false,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Non-major updates merge themselves once every check is green (Renovate waits for the checks itself; no branch protection on private free repos)",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "One weekly PR for all GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Major updates always need a human look",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Postgres majors need dump/restore of the data volume, never automatic",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
